<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTituloPromedio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/titulo_promedio"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nombre"
            android:inputType="textPersonName"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvTituloPromedio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Fila Nota 1 -->
        <EditText
            android:id="@+id/etNota1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nota"
            android:inputType="numberDecimal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/etNombre"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/etPonderacion1"
            app:layout_constraintWidth_percent="0.55" />

        <EditText
            android:id="@+id/etPonderacion1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/hint_ponderacion"
            android:inputType="numberDecimal"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/etNombre"
            app:layout_constraintStart_toEndOf="@id/etNota1"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Fila Nota 2 -->
        <EditText
            android:id="@+id/etNota2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nota"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/etNota1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/etPonderacion2"
            app:layout_constraintWidth_percent="0.55" />

        <EditText
            android:id="@+id/etPonderacion2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/hint_ponderacion"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/etPonderacion1"
            app:layout_constraintStart_toEndOf="@id/etNota2"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Fila Nota 3 -->
        <EditText
            android:id="@+id/etNota3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nota"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/etNota2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/etPonderacion3"
            app:layout_constraintWidth_percent="0.55" />

        <EditText
            android:id="@+id/etPonderacion3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/hint_ponderacion"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/etPonderacion2"
            app:layout_constraintStart_toEndOf="@id/etNota3"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Fila Nota 4 -->
        <EditText
            android:id="@+id/etNota4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nota"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/etNota3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/etPonderacion4"
            app:layout_constraintWidth_percent="0.55" />

        <EditText
            android:id="@+id/etPonderacion4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/hint_ponderacion"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/etPonderacion3"
            app:layout_constraintStart_toEndOf="@id/etNota4"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Fila Nota 5 -->
        <EditText
            android:id="@+id/etNota5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nota"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/etNota4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/etPonderacion5"
            app:layout_constraintWidth_percent="0.55" />

        <EditText
            android:id="@+id/etPonderacion5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/hint_ponderacion"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/etPonderacion4"
            app:layout_constraintStart_toEndOf="@id/etNota5"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnCalcularPromedio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_calcular_promedio"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/etPonderacion5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/btnCalcularPromedio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>